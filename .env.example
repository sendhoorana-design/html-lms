# Copy this file to .env for local development: cp .env.example .env
# On Render/Railway/etc, set these as real environment variables in the dashboard instead —
# do not commit a real .env file to git.

PORT=4000
JWT_SECRET=change-this-to-a-long-random-string

# Local MongoDB: mongodb://127.0.0.1:27017/html_lms
# Atlas free tier: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/html_lms
MONGODB_URI=mongodb://127.0.0.1:27017/html_lms
